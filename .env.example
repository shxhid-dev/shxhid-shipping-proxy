# OTO Shipping Proxy — environment variables
# Copy this file to `.env` for LOCAL dev and fill in the blanks.
# NEVER commit a real .env. On Railway, set these in the service's
# Variables tab — NOT in any committed file.

# ── Secrets ──────────────────────────────────────────────────
# OTO refresh token (long-lived). Paste ONLY into your local .env or
# Railway's Variables dashboard — never into chat, git, or a log.
OTO_REFRESH_TOKEN=

# ── Core config ──────────────────────────────────────────────
# OTO API base URL. Default is correct; override only if OTO tells you to.
OTO_API_BASE=https://api.tryoto.com
# Warehouse city goods ship FROM. This store: Dubai.
ORIGIN_CITY=Dubai
# Fold OTO's COD charge into the displayed price? We show it separately, so keep false.
INCLUDE_COD_IN_PRICE=false
# Comma-separated CORS allow-list of storefront origins (scheme://host, no slash).
# Example: https://nfejky-ge.myshopify.com,https://creativeautomation.ae
ALLOWED_ORIGINS=
# Local dev port. Railway injects its own PORT at runtime — do NOT set it there.
PORT=3000

# ── Rate limiting ────────────────────────────────────────────
# Estimate endpoint: max requests per IP per window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Baseline limit across all routes (/health exempt).
GLOBAL_RATE_LIMIT_MAX=120
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ── Performance / resilience ─────────────────────────────────
# In-memory cache for repeat estimate lookups (ms). 0 disables.
ESTIMATE_CACHE_TTL_MS=120000
# Per-request timeout on OTO calls (ms).
OTO_TIMEOUT_MS=10000
# Retries on transient OTO network failures/timeouts.
OTO_MAX_RETRIES=2
# Reject weightKg above this before calling OTO.
MAX_WEIGHT_KG=1000

# ── Logging ──────────────────────────────────────────────────
# error | warn | info | debug. debug also shows health/preflight requests.
LOG_LEVEL=info
# true = one JSON object per log line (for log aggregators).
LOG_JSON=false

# ── Local dev only ───────────────────────────────────────────
# true = return canned data with no token. NEVER enable on Railway.
OTO_MOCK=
